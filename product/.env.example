# Konfigurasi Koneksi Database MySQL
spring_datasource_username=root
spring_datasource_password=

# port
server_port=8082

spring_profiles_active=local

# Must match JWT_SECRET in the other services.
JWT_SECRET=replace-with-a-shared-random-secret-of-at-least-32-characters

# Local filesystem directory for Product Service v2 image uploads.
PRODUCT_IMAGE_STORAGE_DIR=uploads/products