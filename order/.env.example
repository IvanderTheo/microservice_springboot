# Konfigurasi Koneksi Database MySQL
spring_datasource_username=
spring_datasource_password=

# port
server_port=8083

spring_profiles_active=local

# Must be the same value in every service; use at least 32 random characters.
JWT_SECRET=replace-with-a-shared-random-secret-of-at-least-32-characters
PRODUCT_SERVICE_URL=http://localhost:8082